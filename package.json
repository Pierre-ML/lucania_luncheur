{
  "name": "lucania-luncheur",
  "description": "Lucania Luncheur - installe, met à jour et lance les applications de Pierre-ML",
  "license": "MIT",
  "author": "Pierre Mouilleseaux Lhuillier",
  "keywords": [
    "launcher",
    "astro",
    "tauri"
  ],
  "private": true,
  "type": "module",
  "version": "1.0.1",
