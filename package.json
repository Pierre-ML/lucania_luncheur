    "check": "astro check",
    "astro": "astro",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build && node scripts/build-updater.mjs && node scripts/name-installers.mjs",
    "build:updater": "node scripts/build-updater.mjs",
    "name:installers": "node scripts/name-installers.mjs",
    "version:set": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.1",
    "astro": "^7.3.7",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tauri-apps/cli": "^2.12.1",
    "daisyui": "^5.7.47",
    "typescript": "^6.0.3"
  }
