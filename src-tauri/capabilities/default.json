{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions minimales de la fenêtre principale (pages locales du Lanceur)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-apps-list",
    "allow-apps-refresh",
    "allow-app-install",
    "allow-app-update",
    "allow-app-uninstall",
    "allow-app-launch",
    "allow-app-cancel",
    "allow-self-check-update",
    "allow-self-install-update",
    "allow-self-uninstall",
    "allow-config-get",
    "allow-config-set"
  ]
}
