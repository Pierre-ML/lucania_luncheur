{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lucania Luncheur",
  "version": "0.1.2",
  "identifier": "com.lanceur.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4752",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lucania Luncheur",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://raw.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Pierre Mouilleseaux Lhuillier",
    "copyright": "© 2026 Pierre Mouilleseaux Lhuillier",
    "shortDescription": "Installe, met à jour et lance les applications de Pierre-ML",
    "longDescription": "Installe, met à jour et lance les applications de Pierre-ML",
    "homepage": "https://github.com/Pierre-ML/lucania_luncheur",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "template": "./windows/installer.nsi",
        "languages": ["French", "English"]
      }
    }
  }
}
