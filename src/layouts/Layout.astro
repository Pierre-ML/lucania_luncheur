---
import '../styles/global.css';
interface Props { title?: string }
const { title = 'Lanceur' } = Astro.props;
---
<!doctype html>
<html lang="fr" data-theme="lucania">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Thème et langue appliqués avant le premier rendu (cache local), pour éviter un flash. -->
		<script is:inline>
			try {
				var root = document.documentElement;
				var theme = localStorage.getItem('lanceur.theme') || 'lucania';
				if (theme === 'system') theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				root.dataset.theme = theme;
				var lang = localStorage.getItem('lanceur.lang');
				if (lang !== 'fr' && lang !== 'en') lang = (navigator.language || '').toLowerCase().indexOf('fr') === 0 ? 'fr' : 'en';
				root.lang = lang;
			} catch (e) {}
		</script>
	</head>
	<body class="min-h-screen bg-bg text-fg antialiased">
		<slot />
	</body>
</html>
